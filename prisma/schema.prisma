// GameVault database schema.
// Add your own fields here any time — run `npm run db:push` afterwards
// to sync the change straight to Postgres (no migration files needed
// for a personal single-user project like this).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id          String   @id @default(cuid())

  // Owner. Nullable only so `db push` can add the column to an existing
  // table; ensureTenancy() in lib/tenant.ts claims orphan rows for the
  // admin on first run, and all code sets/filters it.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Core identity ---
  title       String
  platform    String              // e.g. "PS5", "SNES", "Xbox Series X"
  region      String?             // e.g. "PAL", "NTSC-U", "NTSC-J"

  // --- Your physical copy ---
  condition   String?             // e.g. "Complete in box", "Loose cart", "Sealed"
  format      String              @default("Physical") // Physical / Digital
  notes       String?
  personalRating Int?             // 1-10, your own score
  playStatus  String   @default("unplayed") // "unplayed" | "in_progress" | "completed" | "platinum"
  wishlist    Boolean  @default(false)      // true = wanted, hidden from the home grid
  dateAdded   DateTime @default(now())
  datePurchased DateTime?
  purchasePriceGbp Decimal?       @db.Decimal(10, 2)

  // --- Current value (scraped or manual) ---
  valueLooseGbp   Decimal? @db.Decimal(10, 2)
  valueCibGbp     Decimal? @db.Decimal(10, 2)   // complete in box
  valueNewGbp     Decimal? @db.Decimal(10, 2)
  valueUpdatedAt  DateTime?
  valueSource     String?          // "pricecharting" | "manual"

  // --- Steam import ---
  // Set when a game was pulled in from the user's Steam library. Kept so a
  // re-scan can skip games already imported without relying on fuzzy title
  // matching. Null for everything added any other way.
  steamAppId    Int?     // unique per user — see @@unique below

  // --- PlayStation trophy sync ---
  // Set once a game is linked to a PSN title (via Settings -> PlayStation
  // trophies -> "Scan for games", confirming the match). Lets later syncs
  // go straight to this title instead of re-matching by name. Null until
  // linked. See lib/psn.ts.
  psnNpCommunicationId String?
  psnNpServiceName     String?   // "trophy2" (PS5) | "trophy" (PS4/PS3/Vita)
  trophiesSyncedAt     DateTime?
  trophies             Trophy[]

  // --- Steam achievement sync ---
  // The Steam app whose achievement list this game shows. Auto-set to
  // steamAppId for games pulled in via Steam library import; for anything
  // else (including PS4/PS5 games — Settings -> Steam achievements lets
  // you cross-link to that game's Steam release) it's chosen by searching
  // Steam's app list. Earned status only appears if this Steam account
  // has actually played that app — for a cross-linked console game that's
  // simply "no", and the list shows as a reference with nothing ticked.
  // See lib/steam-achievements.ts.
  steamAchievementsAppId    Int?
  steamAchievementsSyncedAt DateTime?
  achievements              Achievement[]

  // --- IGDB metadata ---
  igdbId        Int?     // unique per user — see @@unique below
  coverUrl      String?
  releaseDate   DateTime?
  summary       String?  @db.Text
  genres        String[] @default([])
  developer     String?
  publisher     String?
  aggregatedRating Float?          // IGDB's aggregated critic score (0-100)

  // --- Metacritic (manual or scraped separately) ---
  metacriticScore Int?
  metacriticUrl   String?

  // --- How Long to Beat ---
  hltbMainHours         Float?
  hltbMainExtraHours    Float?
  hltbCompletionistHours Float?
  hltbUpdatedAt         DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, igdbId])
  @@unique([userId, steamAppId])
  @@index([title])
  @@index([platform])
  @@index([wishlist])
  @@index([userId])
}

// Accounts. The first account created (via /api/auth/register on a fresh
// install) is the admin; the admin invites everyone else, and each user
// has a fully separate collection.
model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String    @default("") // empty until an invited user sets it
  role            String    @default("user") // "admin" | "user"
  createdAt       DateTime  @default(now())
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  prefs UserPrefs?
  games Game[]
}

// Per-user display preferences + PlayStation trophy credentials. One row
// per user, created on first read.
model UserPrefs {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scoreBadgeEnabled  Boolean @default(true)
  scoreBadgeBands    String?
  statusBadgeEnabled Boolean @default(true)
  statusColors       String?
  dimCompleted       Boolean @default(true)
  dimPlayedPreviously Boolean @default(false)
  dimStrength        Int     @default(70) // dim overlay opacity, percent

  psnEnabled  Boolean @default(false)
  psnOnlineId String?
  psnNpsso    String?

  // Steam library import. Just the account identifier — the Web API key is
  // instance-wide (Settings.steamApiKey), so there's no per-user secret.
  steamId     String?

  updatedAt DateTime @updatedAt
}

// One row only (id is always "singleton"). Instance-wide integration
// config, admin-only. The score/status/PSN columns below are DEPRECATED —
// they moved to per-user UserPrefs; ensureTenancy() copies their values
// to the admin's UserPrefs once. They stay here only because dropping
// columns needs --accept-data-loss on the container's `prisma db push`.
model Settings {
  id                 String  @id @default("singleton")

  igdbEnabled        Boolean @default(true)
  twitchClientId     String?
  twitchClientSecret String?

  hltbEnabled        Boolean @default(true)

  // "Currently Free" page. The feed is cached in FreeGamesCache and
  // refreshed on the first page visit after it's older than this many
  // hours (plus a manual "Refresh now" button).
  freeGamesEnabled   Boolean @default(true)
  freeGamesTtlHours  Int     @default(3)

  // Steam library import. The key is a single Steam Web API key for the
  // whole instance (https://steamcommunity.com/dev/apikey); each user
  // supplies their own SteamID in their personal settings.
  steamImportEnabled Boolean @default(true)
  steamApiKey        String?

  priceChartingEnabled Boolean @default(true)
  currencyApiUrl       String?

  // --- DEPRECATED: moved to UserPrefs ---
  psnEnabled  Boolean @default(false)
  psnOnlineId String?
  psnNpsso    String?
  scoreBadgeEnabled Boolean @default(true)
  scoreBadgeBands   String?
  statusBadgeEnabled Boolean @default(true)
  statusColors       String?
  dimCompleted       Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// One PSN trophy, belonging to a Game linked via psnNpCommunicationId.
// Fully replaced (delete + recreate) on every sync in lib/psn.ts — earned
// status and dates always come fresh from PSN, so there's nothing to
// diff, and it sidesteps id drift if PSN ever reorders a trophy list.
model Trophy {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  psnTrophyId Int
  groupId     String @default("default") // PSN trophy group: "default" (base game) or "001", "002"... (DLC)
  sortOrder   Int    @default(0)

  name        String
  description String? @db.Text
  iconUrl     String?
  type        String  // "bronze" | "silver" | "gold" | "platinum"
  hidden      Boolean @default(false) // PSN hides the name/description until earned
  rarityPct   Float?  // % of players who have earned it ("trophyEarnedRate")

  earned   Boolean   @default(false)
  earnedAt DateTime?

  @@unique([gameId, psnTrophyId, groupId])
  @@index([gameId])
}

// Single-row cache (id is always "singleton") for the "Currently Free"
// feed. `payload` holds { items: FreeGame[], sourceErrors: [...] } as
// built by lib/free-games.ts. Refreshed when `fetchedAt` is older than
// Settings.freeGamesTtlHours, or on demand via the Refresh button.
model FreeGamesCache {
  id        String   @id @default("singleton")
  payload   Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One Steam achievement, belonging to a Game linked via
// steamAchievementsAppId. Fully replaced (delete + recreate) on every
// sync, same reasoning as Trophy — earned status always comes fresh from
// Steam, nothing worth diffing.
model Achievement {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  steamApiName String // Steam's stable internal id for the achievement
  sortOrder    Int    @default(0)

  name        String
  description String? @db.Text
  iconUrl     String? // unlocked icon
  iconGrayUrl String? // locked icon
  globalPct   Float?  // % of all Steam players who have it

  earned   Boolean   @default(false)
  earnedAt DateTime?

  @@unique([gameId, steamApiName])
  @@index([gameId])
}

// Cached copy of Steam's full app list (~190k entries: {appid, name}),
// used to search for a game's Steam release when linking achievements.
// Steam has no name-search endpoint, so lib/steam-achievements.ts fetches
// the whole list via ISteamApps/GetAppList and matches locally; refreshed
// only occasionally (the list barely changes day to day).
model SteamAppCache {
  id        String   @id @default("singleton")
  payload   Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
